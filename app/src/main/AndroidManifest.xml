<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- NFC（Near Field Communication，近场通信）权限；硬件非必需，允许无 NFC 设备运行手动调试。 -->
    <uses-permission android:name="android.permission.NFC" />
    <uses-feature android:name="android.hardware.nfc" android:required="false" />
    <uses-feature android:name="android.hardware.nfc.hce" android:required="false" />
    <application
        android:name=".SimulatorApp"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.NfcCardSimulator">
        <activity android:name=".ui.cards.CardEditorActivity" android:exported="false" android:windowSoftInputMode="adjustResize" />
        <activity android:name=".ui.cards.CardPackManagerActivity" android:exported="false" />
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <!-- HCE（Host Card Emulation，主机卡模拟）入口由系统绑定；BIND_NFC_SERVICE 保护调用权限。 -->
        <service android:name=".hce.CardEmulationService"
            android:exported="true" android:permission="android.permission.BIND_NFC_SERVICE">
            <intent-filter>
                <action android:name="android.nfc.cardemulation.action.HOST_APDU_SERVICE" />
            </intent-filter>
            <!-- 引用服务说明、支付类别与静态 AID；当前业务 AID 在启动模拟时动态注册。 -->
            <meta-data android:name="android.nfc.cardemulation.host_apdu_service"
                android:resource="@xml/apdu_service" />
        </service>
    </application>

</manifest>
